HandleCommand() {
  Log debug "Got args '$*'"
  local -n __HandleCommand_args="$1"
  local command="${__HandleCommand_args[0]}"
  ShiftArray __HandleCommand_args

  case "$command" in
    login       ) MatrixLogin __HandleCommand_args;;
    logout      ) MatrixLogout __HandleCommand_args;;
    whoami      ) MatrixWhoAmI __HandleCommand_args;;
    server      ) ServerCommandHandler __HandleCommand_args;;
    destination ) DestinationCommandHandler __HandleCommand_args;;
    room        ) RoomCommandHandler __HandleCommand_args;;
    user        ) UserCommandHandler __HandleCommand_args;;
    config      ) Configure __HandleCommand_args;;
    version     ) echo "$projectName v$projectVersion";;
    help        ) PrintHelp __HandleCommand_args;;
    warranty    ) PrintInfo warranty;;
    conditions  ) PrintInfo conditions;;
    exit        ) exit 0;;
    *           ) echo "Unrecognized command '$command'. Type 'help' for help.";;
  esac
}

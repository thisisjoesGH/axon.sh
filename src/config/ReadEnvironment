ReadEnvironment() {
  if [[ -n "$AXON_CONFIG" ]]; then
    LogTerm config "Found configuration in environment."
    local IFS=:
    read -r -a env_config <<< "$AXON_CONFIG"
    unset IFS
    for pair in "${env_config[@]}"; do
      if [[ "$pair" =~ '=' ]]; then
        LogTerm debug "pair is '$pair'"
        key="${pair%%=*}"
        LogTerm debug "key is '$key'"
        value="${pair##*=}"
        LogTerm debug "value is '$value'"
        config[$key]="$value"
      fi
    done
  fi
}

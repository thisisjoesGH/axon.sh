EncodeJSON() {
  local string="$1"
  local -n __EncodeJSON_json="$2"
  local std_out
  local std_err
  CatchStream std_out std_err jq --raw-input <<<"$string" || {
    Log fatal "Failed to encode string as JSON, jq returned error '$std_err'."
  }
  __EncodeJSON_json="$std_out"
}

LogFile() {
  local file_log_type="${1^^}"
  local file_log_message="$2"

#  declare -A config
#  config=(
#    [log_level]="debug"
#    [log_file]="test.log"
#  )

  local log_level="${config[log_level]^^}"
#  echo "Log level is ${config[log_level]^^}"

  case $file_log_type in
    DEBUG  ) if [[ "$log_level" != @(DEBUG) ]]; then return 0; fi;;
    INFO   ) if [[ "$log_level" != @(DEBUG|INFO) ]]; then return 0; fi;;
    WARN   ) if [[ "$log_level" != @(DEBUG|INFO|WARN) ]]; then return 0; fi;;
    ERROR  ) if [[ "$log_level" != @(DEBUG|INFO|WARN|ERROR) ]]; then return 0; fi;;
    FATAL  ) if [[ "$log_level" != @(DEBUG|INFO|WARN|ERROR|FATAL) ]]; then return 0; fi;;
    CONFIG ) if [[ "$log_level" = @(NONE) ]]; then return 0; fi;;
    *      ) if [[ "$log_level" != @(DEBUG) ]]; then return 0; else Log debug "Invalid file log type '$file_log_type' in context '${FUNCNAME[2]}', line number '${BASH_LINENO[1]}'"; fi;;
  esac

  (umask 066; echo "[$(date '+%d/%b/%Y:%H:%M:%S.%3N')] ${file_log_type} - ${FUNCNAME[3]}: $file_log_message" 2>/dev/null >> "${config[log_path]}/${config[log_file]}") ||
  {
    return 1
  }
}


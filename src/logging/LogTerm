LogTerm() {
  local term_log_type="${1^^}"
  local term_log_message="$2"

  local verbosity="${config[verbosity]^^}"

  case $term_log_type in
    DEBUG  ) if [[ "$verbosity" != @(DEBUG) ]]; then return 0; fi;;
    INFO   ) if [[ "$verbosity" != @(DEBUG|INFO) ]]; then return 0; fi;;
    WARN   ) if [[ "$verbosity" != @(DEBUG|INFO|WARN) ]]; then return 0; fi;;
    ERROR  ) if [[ "$verbosity" != @(DEBUG|INFO|WARN|ERROR) ]]; then return 0; fi;;
    FATAL  ) if [[ "$verbosity" != @(DEBUG|INFO|WARN|ERROR|FATAL) ]]; then return 0; fi;;
    CONFIG ) if [[ "$verbosity" != @(DEBUG|INFO) ]]; then return 0; fi;;
    *      ) if [[ "$verbosity" != @(DEBUG) ]]; then return 0; else Log debug "Invalid term log type '$term_log_type' in context '${FUNCNAME[2]}'"; fi;;
  esac

  echo "$term_log_type - $term_log_message" >&2
}

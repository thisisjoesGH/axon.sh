PrintHelp() {
  local -n __PrintHelp_args="$1"
  local subcommand="${__PrintHelp_args[0]}"
  case "$subcommand" in
    login   ) printf '%s\n' 'Usage: login [mxid=<admin user>] [password_file=<filepath>] [save_token=<boolean>]'
              printf '%s\n' '  Logs in to an account on a homeserver.'
              printf '%s\n' '  Options:'
              printf '%s\n' '    [mxid]          The matrix ID to login with. For example `@admin:example.org`.'
              printf '%s\n' '    [password_file] The path to a file containing the password to authenticate with.'
              printf '%s\n' '    [save_token]    Saves the access token retrieved from the server to the configuration file if set to `true`.'
            ;;
    logout  ) printf '%s\n' 'Logs out of the currently logged in account';;
    whoami  ) printf '%s\n' 'Prints the MXID of the currently logged in account';;
    version ) printf '%s\n' 'Prints the axon.sh version.';;
    help    ) printf '%s\n' '😭😭😭';;
    exit    ) printf '%s\n' 'Exits axon.sh.';;
    server      ) printf '%s\n' 'Usage: server <subcommand> [verb] [<option>=<value> ...]'
                  printf '%s\n' '  Subcommands:'
                  printf '%s\n' '    version    Prints version information returned by the locally configured homeserver.'
                  printf '%s\n' '    address    Prints the address of the locally configured homeserver.'
                  printf '%s\n' '    notice [type=<message type>] [body=<text>] [<users=<username(s)>]'
                  printf '%s\n' '      Sends a server notice to one or more local users. Requires proper homeserver configuration.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [type]  The notice event type. Defaults to `m.room.message`.'
                  printf '%s\n' '        [body]  The notice content. Newlines may be inserted with `\n`.'
                  printf '%s\n' '        [users] A comma separated list of local usernames.'
                  printf '\n'
                  printf '%s\n' '    reports [limit=<integer>] OR [details|delete] [id=<report ID>]'
                  printf '%s\n' '      Gets event reports.'
                  printf '%s\n' '      Subcommand options:'
                  printf '%s\n' '        [limit] The maximum number of event reports to retrieve at once. Skips user prompt if passed.'
                  printf '%s\n' '                If there are more total events than the limit set the results will be paginated.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [details] Gets details about the report with the given report ID.'
                  printf '%s\n' '        [delete]  Deletes the report with the given report ID.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [id] The report ID. Skips user prompt if passed.'
                ;;
    destination ) printf '%s\n' 'Usage: destination <subcommand> [destination=<federation destination>]'
                  printf '%s\n' '  Subcommands:'
                  printf '%s\n' '    discover    Prints the base URL found through server discovery for the given federation destination.'
                  printf '%s\n' '    version     Prints software version information for the given federation destination.'
                  printf '%s\n' '    details     Prints federation details about the given federation destination.'
                  printf '%s\n' '    reset       Resets the timeout for the given federation destination.'
                  printf '%s\n' '    rooms       Gets rooms that are federated with the given federation destination.'
                  printf '%s\n' '  Options:'
                  printf '%s\n' '    [destination] A homeserver name. For user `@joe:example.org`, `example.org` is the homeserver name.'
                ;;
    room        ) printf '%s\n' 'Usage: room <subcommand> [verb] [<option>=<value> ...]'
                  printf '%s\n' '  Subcommands:'
                  printf '%s\n' '    purge [room=<room alias or ID>] [include_local=<boolean>] OR [status] [id=<job ID>]'
                  printf '%s\n' '      Purges (deletes) events from a room up to the given date or timestamp. Optionally includes local events.'
                  printf '%s\n' '      Subcommand options:'
                  printf '%s\n' '        [room]          A room alias or identifier.'
                  printf '%s\n' '        [include_local] Also purges local events if set to `true`.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [status] Gets the status of the given purge job ID.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [id] A purge job identifier. Returned after initiating a purge.'
                  printf '\n'
                  printf '%s\n' '    evacuate [room=<room alias or ID>] [block=<boolean>] [purge=<boolean>] [migrate=<boolean>] [room_name="<new room name>"] [mxid=<new room creator>] [message="<new room message>"] OR [status] [id=<job ID>]'
                  printf '%s\n' '      Forces all local users to leave a room. Optionally deletes all events, blocks future joins, and/or moves evacuated users to a new notice room.'
                  printf '%s\n' '      Subcommand options:'
                  printf '%s\n' '        [room]      A room alias or identifier.'
                  printf '%s\n' '        [block]     Blocks local users from joining the room if set to `true`.'
                  printf '%s\n' '        [purge]     Deletes ALL events from the room if set to `true`.'
                  printf '%s\n' '        [migrate]   Moves all local users evacuated from the room to a new notice room if set to `true`.'
                  printf '%s\n' '        [room_name] The name of the notice room.'
                  printf '%s\n' '        [mxid]      The MXID of the account which will create the notice room. It is suggested that you use a reserved user account as the creator.'
                  printf '%s\n' '        [message]   The message to send to the notice room. Surround with double-quotes to protect spaces. New lines may be inserted with `\n`.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [status]  Gets the status of the given evacuation job ID.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [id] An evacuation job identifier. Returned after initiating an evacuation.'
                  printf '\n'
                  printf '%s\n' '    create [name=<room name>] [topic=<room description>] [preset=<room state preset>] [federate=<boolean>]'
                  printf '%s\n' '      Creates a new room.'
                  printf '%s\n' '      Subcommand options:'
                  printf '%s\n' '        [name]     The name of the new room.'
                  printf '%s\n' '        [topic]    The topic or description of the new room.'
                  printf '%s\n' '        [federate] Allows other homeservers to participate in the room if set to `true`.'
                  printf '%s\n' '        [preset]   The state preset of the new room. One of `public`, `private`, or `trusted`.'
                  printf '%s\n' '                   Presets:'
                  printf '%s\n' '                     `public`  Anyone may join. Members may view all room history. Guests are forbidden.'
                  printf '%s\n' '                     `private` An invite is required to join. Members may view all room history. Guests are allowed.'
                  printf '%s\n' '                     `trusted` All members are admins. An invite is required to join. Members may view all room history. Guests are allowed.'
                  printf '\n'
                  printf '%s\n' '    members [room=<room alias or ID>] [homeserver=<homeserver name]'
                  printf '%s\n' '      Returns joined members for the given room. Optionally filters members by homeserver name.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [room]       A room alias or identifier.'
                  printf '%s\n' '        [homeserver] A homeserver name. Filters non-resident members from the output when passed.'
                  printf '\n'
                  printf '%s\n' '    extremities [delete] [room=<room alias or ID>]'
                  printf '%s\n' '      Returns forward extremities for the given room alias or ID.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [delete] Deletes forward extremities.'
                  printf '%s\n' '      Shared options:'
                  printf '%s\n' '        [room] A room alias or identifier.'
                  printf '\n'
                  printf '%s\n' '    details [room=<room alias or ID>]'
                  printf '%s\n' '      Returns details about the given room.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [room] A room alias or identifier.'
                  printf '\n'
                  printf '%s\n' '    alias [delete] [alias=<room alias>] OR [create] [[alias=<room alias>] [room=<room alias or ID>]]'
                  printf '%s\n' '      Resolves the given room alias to a room ID and lists all participating homeservers.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [delete] Deletes an alias.'
                  printf '%s\n' '        [create] Creates an alias bound to the given room.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [room] An existing room alias or identifier.'
                  printf '%s\n' '      Shared options:'
                  printf '%s\n' '        [alias] A new room alias.'
                  printf '\n'
                  printf '%s\n' '    visibility [set] [room=<room alias or ID>] [visibility={public|private}]'
                  printf '%s\n' '      Returns or manipulates the room directory visibility for the given room.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [set] Sets the room visibility.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [visibility] One of either `public` or `private`.'
                  printf '%s\n' '      Shared options:'
                  printf '%s\n' '        [room] A room alias or identifier.'
                ;;
    user        ) printf '%s\n' 'Usage: user <subcommand> [verb] [<option>=<value> ...]'
                  printf '%s\n' '  Subcommands:'
                  printf '%s\n' '    shadowban     Shadowbans a user.'
                  printf '%s\n' '    unshadowban   Un-shadowbans a user.'
                  printf '%s\n' '    create [user=<username>] [displayname=<text>] [password_file=<filepath>] [admin=<boolean>]'
                  printf '%s\n' '      Creates a new user.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [user]          The username for the new user.'
                  printf '%s\n' '        [displayname]   The display name for the new user. Defaults to the username if not passed.'
                  printf '%s\n' '        [password_file] The path to a file containing the password for the new user.'
                  printf '%s\n' '        [admin]         Makes the user a server admin if set to `true`.'
                  printf '\n'
                  printf '%s\n' '    password [user=<username>] [password_file=<filepath>] [logout=<boolean>]'
                  printf '%s\n' '      Resets a user'\''s password. Optionally logs the user out of all devices.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [user]          A local username.'
                  printf '%s\n' '        [password_file] The path to a file containing the new password.'
                  printf '%s\n' '        [logout]        Logs out all of the user'\''s devices if set to `true`.'
                  printf '\n'
                  printf '%s\n' '    deactivate [user=<username>] [erase=<boolean>]'
                  printf '%s\n' '      Deactivates a user. Optionally erases the user'\''s profile.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [user]  A local username.'
                  printf '%s\n' '        [erase] Erases the user'\''s profile if set to `true`.'
                  printf '\n'
                  printf '%s\n' '    rooms [user=<username>]'
                  printf '%s\n' '      Shows all rooms a user is currently a member of.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [user] A local username.'
                  printf '\n'
                  printf '%s\n' '    join [user=<username>] [room=<room alias or ID>]'
                  printf '%s\n' '      Joins a user to the given room.'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [user] A local username.'
                  printf '%s\n' '        [room] A room alias identifier.'
                  printf '\n'
                  printf '%s\n' '    redact [user=<username>] [reason="<text>"] OR [status] [id=<job ID>]'
                  printf '%s\n' '      Redacts a users messages. Optionally provides a publicly visible reason.'
                  printf '%s\n' '      Subcommand options:'
                  printf '%s\n' '        [user]   The username whose messages should be redacted.'
                  printf '%s\n' '        [reason] The publicly visible reason for the redaction. Surround with double-quotes to protect spaces.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [status] Gets the status of the given redaction job ID.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [job ID] The redaction job ID. Returned after initiating a user redaction.'
                  printf '\n'
                  printf '%s\n' '    threepid [medium=<3PID medium>] [address=<3PID address>]'
                  printf '%s\n' '      Returns the MXID of the user associated with the given third-party ID (3PID).'
                  printf '%s\n' '      Options:'
                  printf '%s\n' '        [medium]  The medium of the 3PID, e.g. `email`.'
                  printf '%s\n' '        [address] The address of the 3PID, e.g. `user@example.com`.'
                  printf '\n'
                  printf '%s\n' '    ratelimit [set|delete] [user=<username>] [messages_per_second=<integer>] [burst_count=<integer>]'
                  printf '%s\n' '      Returns or manipulates the ratelimit override for the given user.'
                  printf '%s\n' '      Verbs:'
                  printf '%s\n' '        [set]    Sets the ratelimit override for the given user.'
                  printf '%s\n' '        [delete] Deletes the ratelimit override for the given user.'
                  printf '%s\n' '        Verb options:'
                  printf '%s\n' '          [messages_per_second] The maximum messages per second to allow.'
                  printf '%s\n' '          [burst_count]         The number of messages sent before the ratelimit is applied.'
                  printf '%s\n' '      Shared options:'
                  printf '%s\n' '        [user] The username whose ratelimit should be returned or manipulated.'
                ;;
    config      ) printf '%s\n' 'Usage: config [key] [value]'
                  printf '%s\n' '  Prints all configuration keys and their values when no arguments are given.'
                  printf '%s\n' '  Optional arguments:'
                  printf '%s\n' '    [key]   The name of a configuration option. If no value argument is given, prints the current value.'
                  printf '%s\n' '    [value] The new value for the given configuration option.'
                ;;
    ''          ) printf '%s\n' 'Usage: <COMMAND> [SUBCOMMAND] [VERB] [<OPTION>=<VALUE> ...]'
                  printf '%s\n' '  VERB must immediately follow a SUBCOMMAND.'
                  printf '%s\n' '  OPTION(s) may be passed in any order.'
                  printf '%s\n' '  VALUE(s) containing spaces must be quoted.'
                  printf '\n'
                  printf '%s\n' '  COMMANDS:'
                  printf '%s\n' '    login          Logs in to an account on a homeserver.'
                  printf '%s\n' '    logout         Logs out of an account on a homeserver.'
                  printf '%s\n' '    whoami         Prints the MXID of the currently logged in account.'
                  printf '%s\n' '    server         Performs homeserver related actions. Takes a subcommand as an option.'
                  printf '%s\n' '    destination    Performs federation destination related actions. Takes a subcommand as an option.'
                  printf '%s\n' '    room           Performs room related actions. Takes a subcommand as an option.'
                  printf '%s\n' '    user           Performs user account related actions.'
                  printf '%s\n' '    config         Prints or modifies the axon.sh configuration.'
                  printf '%s\n' '    version        Prints the axon.sh version.'
                  printf '%s\n' '    help           Prints usage information. Takes another command as an option.'
                  printf '%s\n' '    exit           Exits axon.sh.'
                  printf '\n'
                  printf '%s\n' '  GLOBAL OPTIONS:'
                  printf '%s\n' '    These options may be used with any command or subcommand.'
                  printf '%s\n' '    [format] The format which should be used when printing output.'
                  printf '%s\n' '             Defaults to `human` but may be one of the following:'
                  printf '%s\n' '             `human`, `json`, `pairs`, `plain`, `raw`'
                  printf '\n'
                  printf '%s\n' '    [keys]   The keys which should be returned in command output.'
                  printf '%s\n' '             Valid keys for a command can be easily discovered by using the `pairs` output format.'
                ;;
    *           ) Log error "Unknown subcommand '$subcommand'. Type 'help' with no options for a list of commands."
                ;;
  esac
}

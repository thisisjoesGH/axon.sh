PrintHelp() {
  local -n __PrintHelp_args="$1"
  local subcommand="${__PrintHelp_args[0]}"
  case "$subcommand" in
    login   ) echo 'Logs in to an account on a homeserver.';;
    logout  ) echo 'Logs out of the currently logged in account';;
    whoami  ) echo 'Prints the MXID of the currently logged in account';;
    version ) echo 'Prints the axon.sh version.';;
    help    ) echo '😭😭😭';;
    exit    ) echo 'Exits axon.sh.';;
    server      ) echo 'Usage: server <subcommand> [verb] [<option>=<value> ...]'
                  echo '  Subcommands:'
                  echo '    version    Prints version information returned by the locally configured homeserver.'
                  echo '    address    Prints the address of the locally configured homeserver.'
                  echo '    notice [type=<message type>] [body=<text>] [<users=<username(s)>]'
                  echo '      Sends a server notice to one or more local users. Requires proper homeserver configuration.'
                  echo '      Options:'
                  echo '        [type]  The notice event type. Defaults to `m.room.message`.'
                  echo '        [body]  The notice content. Newlines may be inserted with `\n`.'
                  echo '        [users] A comma seperated list of local usernames. For'
                  echo
                  echo '    reports [limit=<integer>] OR [details|delete] [id=<report ID>]'
                  echo '      Gets event reports.'
                  echo '      Subcommand options:'
                  echo '        [limit] The maximum number of event reports to retrieve at once. Skips user prompt if passed.'
                  echo '                If there are more total events than the limit set the results will be paginated.'
                  echo '      Verbs:'
                  echo '        [details] Gets details about the report with the given report ID.'
                  echo '        [delete]  Deletes the report with the given report ID.'
                  echo '        Verb options:'
                  echo '          [id] The report ID. Skips user prompt if passed.'
                ;;
    destination ) echo 'Usage: destination <subcommand> [destination=<federation destination>]'
                  echo '  Subcommands:'
                  echo '    discover    Prints the base URL found through server discovery for the given federation destination.'
                  echo '    version     Prints software version information for the given federation destination.'
                  echo '    details     Prints federation details about the given federation destination.'
                  echo '    reset       Resets the timeout for the given federation destination.'
                  echo '  Options:'
                  echo '    [destination] A homeserver name. For user `@joe:example.org`, `example.org` is the homeserver name.'
                ;;
    room        ) echo 'Usage: room <subcommand> [verb] [<option>=<value> ...]'
                  echo '  Subcommands:'
                  echo '    purge [id=<room ID>] [include_local=<boolean>] OR [status] [id=<job ID>]'
                  echo '      Purges events from a room up to the given date or timestamp. Optionally includes local events.'
                  echo '      Subcommand options:'
                  echo '        [id] A room identifier.'
                  echo '        [include_local]'
                  echo '      Verbs:'
                  echo '        [status] Gets the status of the given purge job ID.'
                  echo '        Verb options:'
                  echo '          [id] A purge job identifier. Returned after initiating a purge.'
                  echo
                  echo '    evacuate [id=<room ID>] [block=<boolean>] [purge=<boolean>] [migrate=<boolean>] [room_name="<new room name>"] [mxid=<new room creator>] [message="<new room message>"] OR [status] [id=<job ID>]'
                  echo '      Forces all local users to leave a room. Optionally deletes all events, blocks future joins, and/or moves evacuated users to a new notice room.'
                  echo '      Subcommand options:'
                  echo '        [id]        A room identifier.'
                  echo '        [block]     Blocks local users from joining the room if set to `true`.'
                  echo '        [purge]     Deletes ALL events from the room if set to `true`.'
                  echo '        [migrate]   Moves all local users evacuated from the room to a new notice room if set to `true`.'
                  echo '        [room_name] The name of the notice room.'
                  echo '        [mxid]      The MXID of the account which will create the notice room. It is suggested that you use a reserved user account as the creator.'
                  echo '        [message]   The message to send to the notice room. Surround with double-quotes to protect spaces. New lines may be inserted with `\n`.'
                  echo '      Verbs:'
                  echo '        [status]  Gets the status of the given evacuation job ID.'
                  echo '        Verb options:'
                  echo '          [id] An evacuation job identifier. Returned after initiating an evacuation.'
                  echo
                  echo '    extremities [delete] [room=<room alias or ID>]'
                  echo '      Returns forward extremities for the given room alias or ID.'
                  echo '      Verbs:'
                  echo '        [delete] Deletes forward extremities.'
                  echo '      Shared options:'
                  echo '        [room] A room alias or identifier.'
                  echo
                  echo '    details [id=<room ID>]'
                  echo '      Returns details about the given room ID.'
                  echo '      Options:'
                  echo '        [id]  A room identifier.'
                  echo
                  echo '    alias [delete] [alias=<room alias>] OR [create] [[alias=<room alias>] [id=<room ID>]]'
                  echo '      Resolves the given room alias to a room ID and lists all participating homeservers.'
                  echo '      Verbs:'
                  echo '        [delete] Deletes an alias.'
                  echo '        [create] Creates an alias bound to the given room ID.'
                  echo '        Verb options:'
                  echo '          [id] A room identifier.'
                  echo '      Shared options:'
                  echo '        [alias] A room alias.'
                  echo
                  echo '    visibility [set] [id=<room ID>] [visiblity={public|private}]'
                  echo '      Returns or manipulates the room directory visibility for the given room ID.'
                  echo '      Verbs:'
                  echo '        [set] Sets the room visibility.'
                  echo '        Verb options:'
                  echo '          [visiblity] One of either `public` or `private`.'
                  echo '      Shared options:'
                  echo '        [id] A room identifier.'
                ;;
    user        ) echo 'Usage: user <subcommand> [verb] [<option>=<value> ...]'
                  echo '  Subcommands:'
                  echo '    create        Creates a new user.'
                  echo '    password      Resets a user'\''s password. Optionally logs the user out of all devices.'
                  echo '    deactivate    Deactivates a user. Optionally erases the user'\''s profile.'
                  echo '    shadowban     Shadowbans a user.'
                  echo '    unshadowban   Un-shadowbans a user.'
                  echo '    rooms [user=<username>]'
                  echo '      Shows all rooms a user is currently a member of.'
                  echo '      Options:'
                  echo '        [user] A local username.'
                  echo 
                  echo '    redact [user=<username>] [reason="<text>"] OR [status] [id=<job ID>]'
                  echo '      Redacts a users messages. Optionally provides a publicly visible reason.'
                  echo '      Subcommand options:'
                  echo '        [user]   The username whose messsages should be redacted.'
                  echo '        [reason] The publicly visible reason for the redaction. Surround with double-quotes to protect spaces.'
                  echo '      Verbs:'
                  echo '        [status] Gets the status of the given redaction job ID.'
                  echo '        Verb options:'
                  echo '          [job ID] The redaction job ID. Returned after intitiation a user redaction.'
                  echo
                  echo '    threepid [medium=<3PID medium>] [address=<3PID address>]'
                  echo '      Returns the MXID of the user associated with the given third-party ID (3PID).'
                  echo '      Options:'
                  echo '        [medium]  The medium of the 3PID, e.g. `email`.'
                  echo '        [address] The address of the 3PID, e.g. `user@example.com`.'
                  echo
                  echo '    ratelimit [set|delete] [user=<username>] [messages_per_second=<integer>] [burst_count=<integer>]'
                  echo '      Returns or manipulates the ratelimit override for the given user.'
                  echo '      Verbs:'
                  echo '        [set]    Sets the ratelimit override for the given user.'
                  echo '        [delete] Deletes the ratelimit override for the given user.'
                  echo '        Verb options:'
                  echo '          [messages_per_second] The maximum messages per second to allow.'
                  echo '          [burst_count]         The number of messages sent before the ratelimit is applied.'
                  echo '      Shared options:'
                  echo '        [user] The username whose ratelimit should be returned or manipulated.'
                ;;
    config      ) echo 'Usage: config [key] [value]'
                  echo '  Prints all configuration keys and their values when no arguments are given.'
                  echo '  Optional arguments:'
                  echo '    [key]   The name of a configuration option. If no value argument is given, prints the current value.'
                  echo '    [value] The new value for the given configuration option.'
                ;;
    ''          ) echo 'Usage: <COMMAND> [SUBCOMMAND] [VERB] [<OPTION>=<VALUE> ...]'
                  echo '  VERBS must immediately follow a SUBCOMMAND.'
                  echo '  OPTION(s) may be passed in any order.'
                  echo '  VALUE(s) containing spaces must be quoted.'
                  echo
                  echo '  COMMANDS:'
                  echo '    login          Logs in to an account on a homeserver.'
                  echo '    logout         Logs out of an account on a homeserver.'
                  echo '    whoami         Prints the MXID of the currently logged in account.'
                  echo '    server         Performs homeserver related actions. Takes a subcommand as an option.'
                  echo '    destination    Performs federation destination related actions. Takes a subcommand as an option.'
                  echo '    room           Performs room related actions. Takes a subcommand as an option.'
                  echo '    user           Performs user account related actions.'
                  echo '    config         Prints or modifies the axon.sh configuration.'
                  echo '    version        Prints the axon.sh version.'
                  echo '    help           Prints usage information. Takes another command as an option.'
                  echo '    exit           Exits axon.sh.'
                ;;
    *           ) Log error "Unknown subcommand '$subcommand'. Type 'help' with no options for a list of commands."
                ;;
  esac
}

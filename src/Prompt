Prompt() {
  HISTCONTROL=ignoreboth
  HISTFILE=${config[log_path]}/${config[history_file]}
  history -n || Log warn "Failed to load history from '$HISTFILE'"
  local initial_text="$1"
  while true; do
    local prompt="[axon]>"
    local user_input
    Read -e -r -p "$prompt" -i "$initial_text" user_input
    # handle unmatched quotes
    local position
    FindUnmatchedQuotes "$user_input" position || {
      Log error "Unmatched quote in input at position '$position'."
      local padding=$(( "${#prompt}" + "$position" ))
      printf "%${padding}s\n" 'v'
      initial_text="$user_input"
      continue
    }
    initial_text=''

    [[ "${config[verbosity]^^}" == 'DEBUG' ]] && local debug='true'
    readarray -t -d $'\0' ${debug:+-c 1 -C 'printf "DEBUG - input[%s] => %s\n"'} input < <(xargs -n1 printf '%s\0' <<< "$user_input" 2>/dev/null) || {
      Log fatal "Failed while reading user input into array."
      exit 1
    }
    [[ -n "${input[*]}" ]] || {
      PrintHelp input
      continue
    }
    history -s "$user_input" || Log warn "Failed to append entry to history"
    history -w || Log warn "Failed to write history to '$HISTFILE'"
    HandleCommand input
  done
}

Prompt() {
  HISTCONTROL=ignoreboth
  HISTFILE=${config[config_path]}/${config[history_file]}
  history -n || Log warn "Failed to load history from '$HISTFILE'"
  while true; do
    local prompt="[axon]>"
    local user_input
    Read -e -r -p "$prompt" user_input
    # create array from input, escape special characters
    # TODO: handle unmatched quotes?
    local -a input="(${user_input//[()<>&]/\\&})"
    local index
    for index in "${!input[@]}"; do
      # unescape characters in array elements
      local char
      for char in '(' ')' '<' '>' '&'; do
        input[$index]="${input[$index]//\\"$char"/"$char"}"
      done
    done
    [[ -n "${input[*]}" ]] || {
      PrintHelp input
      continue
    }
    history -s "$user_input" || Log warn "Failed to append entry to history"
    history -w || Log warn "Failed to write history to '$HISTFILE'"
    HandleCommand input
  done
}

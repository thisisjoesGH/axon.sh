CancelPrompt() {
  local context="${FUNCNAME[2]}"
  Log debug "Called in context '$context'."

  case "$context" in
    Prompt )
      Exit
    ;;
    *      )
      unset IFS
      echo
      Log info "Cancelling current prompt."
      echo "Press again to exit."
      Prompt
    ;;
  esac
}

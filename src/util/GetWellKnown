GetWellKnown() {
  local server_name="$1"
  local -n __GetWellKnown_homeserver="$2" || {
    Log fatal "Empty reference'"
    exit 1
  }

  [[ "$server_name" ]] || {
    Log error "No server name passed."
    return 1
  }

  local -A params=(
    [method]="GET"
    [host]="$server_name"
    [path]="/.well-known/matrix/server"
    [port]="443"
    [keys]="m.server"
    [auth]="false"
    [redirect]="true"
  )
    local -A response
    Request params response || {
      Log error "Well-known discovery failed."
      return 1
    }
    CheckStatusCode "${response[status]}" || {
      Log error "Well-known discovery failed."
      return 1
    }

    local -a keys=(m.server)
    local -A values
    ProcessResponse response[body] keys values || return 1

  __GetWellKnown_homeserver="${values[m.server]}"
  Log info "Server is '$__GetWellKnown_homeserver'"
}

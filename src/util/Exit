Exit() {
  printf '\n'
  Log info "Exiting..."
  if [[ "${config[save_token]}" == 'false' && -n "${config[admin_token]}" ]]; then
    Log debug "User preference is to not save token, destroying session..."
    DestroySession || exit 1
  fi
  echo "Goodbye!"
  exit 0
}

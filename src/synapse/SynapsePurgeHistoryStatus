SynapsePurgeHistoryStatus() {
  Log debug "Got args '$*'"

  # copy api map to local map
  local -A api
  CopyArray s_purge_history_status_api api
  # copy url parameters to local map
  local -A url_params
  CopyArray s_purge_history_status_url_params url_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || return 1

  Log info "Getting purge history job status from '${config[homeserver]}'"

  local -n __SynapsePurgeHistoryStatus_args="$1"
  local -A options
  ParseOptions __SynapsePurgeHistoryStatus_args options || return 1
  local job_id="${options[id]}"
  # ask for job ID if not passed
  [[ -n "$job_id" ]] || {
    Read -r -p "Job ID:" input_job_id
    job_id="$input_job_id"
  }
  url_params[job_id]="$job_id"
  Log debug "URL 'job_id' param set to '${url_params[job_id]}'"

  SetPathParameters url_params api[path]

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }

  # get key values
  local -a keys=(status error)
  local -A values
  ProcessResponse response[body] keys values || return 1
  if [[ "${values[status]}" != "failed" ]]; then
    unset -v 'keys[1]'
  fi

  local output="${response[body]}"
  FormatOutput "${options[format]}" keys values output || return 1
  printf '%s\n' "$output"
}

SynapseRoomDetails() {
  Log debug "Got args '$*'"
  # copy api map to local map
  local -A api
  CopyArray s_room_details_api api
  # copy url parameters to local map
  local -A url_params
  CopyArray s_room_details_url_params url_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || return 1

  Log info "Getting room details from ${config[homeserver]}"

  local -n __SynapseRoomDetails_args="$1"
  local -A options
  ParseOptions __SynapseRoomDetails_args options || return 1
  # input
  local room_id="${options[id]}"
  [[ -n "$room_id" ]] || {
    local input_room_id
    Read -r -p "Room ID:" input_room_id
    room_id="$input_room_id"
  }
  Log debug "Room ID is '$room_id'"
  ValidateInput text "$room_id" || return 1
  url_params[room_id]="$room_id"
  Log debug "URL 'room_id' param set to '${url_params[room_id]}'"

  SetPathParameters url_params api[path]

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }

  # get key values
  local -a keys=(room_id room_type name avatar topic canonical_alias joined_members joined_local_members joined_local_devices version creator encryption federatable public join_rules guest_access history_visibility state_events forgotten)
  if [[ -n "${options[json_keys]}" ]]; then
    local -a keys=()
    local IFS=,
    read -r -a keys <<<"${options[json_keys]}"
    unset IFS
  fi
  local -A values
  ProcessResponse response[body] keys values || return 1

  local output="${response[body]}"
  FormatOutput "${options[format]}" keys values output || return 1
  printf '%s\n' "$output"
}

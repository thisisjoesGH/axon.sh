SynapseDestinationDetails() {
  Log debug "Got args '$*'"

  # copy api map to local map
  local -A api
  CopyArray s_destination_details_api api
  # copy url parameters to local map
  local -A url_params
  CopyArray s_destination_details_url_params url_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || {
    ConfirmContinue || return 1
  }

  Log info "Getting destination details from ${config[homeserver]}"

  local -n __SynapseDestinationDetails_args="$1"
  local -A options
  ParseOptions __SynapseDestinationDetails_args options || return 1
  # input
  local destination="${options[destination]}"
  [[ -n "$destination" ]] || {
    Read -r -p "Destination: " destination
  }
  Log debug "Destination is '$destination'"
  ValidateInput host "$destination" || return 1
  url_params[destination]="$destination"
  Log debug "URL 'destination' param set to '${url_params[destination]}'"

  SetPathParameters url_params api[path]

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }

  # get key values
  local -a keys=(destination retry_last_ts retry_interval failure_ts last_successful_stream_ordering)
  [[ -z "${options[keys]}" ]] || {
    Explode ',' "${options[keys]}" keys
  }
  local -A values
  ProcessResponse response[body] keys values || return 1
  if [[ "${values[failure_ts]}" != "null" ]]; then
    keys=(destination failed failure_ts retry_last_ts retry_interval last_successful_stream_ordering)
    values[failed]=true
    values[retry_interval]="$(ConvertIntervalMs "${values[retry_interval]}")" || return 1
    values[failure_ts]="$(ConvertUnixTimestampMs "${values[failure_ts]}")" || return 1
    values[retry_last_ts]="$(ConvertUnixTimestampMs "${values[retry_last_ts]}")" || return 1
  else
    values[failed]=false
    unset -v 'keys[1]' 'keys[2]' 'keys[3]'
    keys=(destination failed "${keys[@]:1}")
  fi

  local output="${response[body]}"
  FormatOutput "${options[format]}" keys values output || return 1
  printf '%s\n' "$output"
}

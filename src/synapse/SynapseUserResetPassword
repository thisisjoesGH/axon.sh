SynapseUserResetPassword() {
  Log debug "Got args '$*'"

  # copy api map to local map
  local -A api
  CopyArray s_user_reset_password_api api
  # copy url parameters to local map
  local -A url_params
  CopyArray s_user_reset_password_url_params url_params
  # copy body parameters to local map
  local -A body_params
  CopyArray s_user_reset_password_body_params body_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || return 1

  Log info "Resetting user password on homeserver ${config[homeserver]}"

  local -n __SynapseUserResetPassword_args="$1"
  local -A options
  ParseOptions __SynapseUserResetPassword_args options || return 1
  # input
  local username="${options[user]}"
  [[ -n "$username" ]] || {
    Read -r -p "Username to reset password for:" username
  }
  local user_id="@$username:${config[homeserver]}"
  Log debug "User ID is '$user_id'"
  url_params[user_id]="$user_id"
  Log debug "URL 'user_id' param set to '${url_params[user_id]}'"

  local password
  [[ -n "${options[password_file]}" ]] && {
    local path="${options[password_file]}"
    password="$(ReadFile "$path")"
  }
  [[ -n "$password" ]] || {
    Read -r -p "New password:" password
  }
  body_params[password]="$password"

  local logout="${options[logout]}"
  [[ -n "$logout" ]] || {
    local input
    Read -r -p "Logout all devices? (y/N):" input
    case "$input" in
      [yY]|[Yy][Ee][Ss] ) logout="true";;
      [Nn]|[Nn][Oo]|''  ) logout="false";;
    esac
  }

  ValidateInput boolean "$logout"
  body_params[logout]="$logout"

  SetPathParameters url_params api[path]

  # construct request body
  local object
  ConstructObject s_user_reset_password body_params object || return 1

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
    [data]="$object"
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }
}

SynapseServerNotice() {
  Log debug "Got args '$*'"

  # copy api map to local map
  local -A api
  CopyArray s_server_notice_api api
  # copy body parameters to local map
  local -A body_params
  CopyArray s_server_notice_body_params body_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || return 1

  Log info "Sending server notice on homeserver ${config[homeserver]}"

  local -n __SynapseServerNotice_args="$1"
  local -A options
  ParseOptions __SynapseServerNotice_args options || return 1
  # input
  local message_type="${options[type]}"
  # only prompt for type if no body passed
  [[ -n "${options[body]}" ]] || {
    local input_message_type
    Read -r -p "Message type (m.room.message):" input_message_type
    [[ -z "$input_message_type" ]] || {
      ValidateInput text "$input_message_type" || return 1
      message_type="$input_message_type"
    }
  }
  body_params[msg_type]="$message_type"

  local message_body="${options[body]}"
  [[ -n "$message_body" ]] || {
    local input_message_body
    Read -r -p "Message body:" input_message_body
    message_body="$input_message_body"
  }
  ValidateInput text "$message_body" || return 1
  body_params[body]="$message_body"

  local -a usernames
  local IFS=,
  read -r -a usernames <<<"${options[users]}"
  unset IFS
  [[ -n "${usernames[*]}" ]] || {
    local -a input_usernames
    local IFS=,
    Read -r -p "Target username(s):" -a input_usernames
    unset IFS
    CopyArray input_usernames usernames
  }

  local -a user_ids
  for username in "${usernames[@]}"; do
    user_ids+=("@${username}:${config[homeserver]}")
  done

  for user_id in "${user_ids[@]}"; do
    Log debug "User ID is '$user_id'"
    body_params[user_id]="$user_id"
    Log debug "Body 'user_id' param set to '${body_params[user_id]}'"
    Log info "Sending server notice to '${body_params[user_id]}'."

    # construct request body
    local object
    ConstructObject s_server_notice body_params object || return 1

    # set request parameters
    local -A params=(
      [method]="${api[method]}"
      [path]="${api[path]}"
      [data]="$object"
    )
    # make request
    local -A response
    Request params response || return 1
    CheckStatusCode "${response[status]}" || {
      if [[ "${response[status]}" == 429 ]]; then
        RetryRequest params response || return 1
      else
        HandleMatrixError response[body]
        return 1
      fi
    }
  done
}

SynapseUserJoinedRooms() {
  Log debug "Got args '$*'"

  # copy api map to local map
  local -A api
  CopyArray s_user_joined_rooms_api api
  # copy path parameters to local map
  local -A path_params
  CopyArray s_user_joined_rooms_path_params path_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || {
    ConfirmContinue || return 1
  }

  Log info "Getting joined rooms for user on ${config[homeserver]}"

  local -n __SynapseUserJoinedRooms_args="$1"
  local -A options
  ParseOptions __SynapseUserJoinedRooms_args options || return 1
  # input
  local username="${options[user]}"
  [[ -n "$username" ]] || {
    local input_username
    Read -r -p "User name: " input_username
    username="$input_username"
  }
  ValidateInput text "$username" || return 1
  local user_id="@$username:${config[homeserver]}"
  Log debug "User ID is '$user_id'"
  PutArray path_params[user_id] "$user_id"
  Log debug "URL 'user_id' path param set to '${path_params[user_id]}'"

  SetPathParameters path_params api[path]

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
    [auth]='true'
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }

  # get key values
  local -a keys=(joined_rooms total)
  [[ -z "${options[keys]}" ]] || {
    Explode ',' "${options[keys]}" keys
  }
  local -A values
  ProcessResponse response[body] keys values || return 1

  local output="${response[body]}"
  FormatOutput "${options[format]}" keys values output || return 1
  printf '%s\n' "$output"
}

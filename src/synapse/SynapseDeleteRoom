SynapseDeleteRoom() {
  Log debug "Got args '$*'"
  local -n __SynapseDeleteRoom_args="$1"
  if [[ "${__SynapseDeleteRoom_args[0]}" = "status" ]]; then
    ShiftArray __SynapseDeleteRoom_args
    SynapseDeleteRoomStatus __SynapseDeleteRoom_args || return 1
    return 0
  fi

  # copy api map to local map
  local -A api
  CopyArray s_delete_room_api api
  # copy url parameters to local map
  local -A url_params
  CopyArray s_delete_room_url_params url_params
  # copy body parameters to local map
  local -A body_params
  CopyArray s_delete_room_body_params body_params

  CheckLoginStatus || return 1
  CheckServerSupport 'api[minimum_version]' || return 1

  Log info "Deleting room from ${config[homeserver]}"

  local -A options
  ParseOptions __SynapseDeleteRoom_args options || return 1
  # input
  [[ -n "${options[room_id]}" ]] || {
    local input_room_id
    Read -r -p "Room ID:" input_room_id
    options[room_id]="$input_room_id"
  }
  url_params[room_id]="${options[room_id]}"
  Log debug "URL 'room_id' param set to '${url_params[room_id]}'"

  [[ -n "${options[block]}" ]] || {
    local input_block_joins
    Read -r -p "Block users from rejoining the room? (y/N):" input_block_joins
    case "$input_block_joins" in
      [yY]|[Yy][Ee][Ss] ) options[block]='true';;
      [Nn]|[Nn][Oo]     ) options[block]='false';;
    esac
  }
  body_params[block]="${options[block]}"

  [[ -n "${options[purge]}" ]] || {
    local input_purge_events
    Read -r -p "Purge all events? (y/N):" input_purge_events
    case "$input_purge_events" in
      [yY]|[Yy][Ee][Ss] ) options[purge]='true';;
      [Nn]|[Nn][Oo]     ) options[purge]='false';;
    esac
  }
  body_params[purge]="${options[purge]}"

  [[ -n "${options[move_users]}" ]] || {
    local input_move_users
    Read -r -p "Move removed users to new room? (y/N):" input_move_users
    case "$input_move_users" in
      [yY]|[Yy][Ee][Ss]) options[move_users]='true';;
      [Nn]|[Nn][Oo]|*  ) options[move_users]='false';;
    esac
    Log debug "Option move_users set to '${options[move_users]}'."
  }

  if [[ "${options[move_users]}" == true ]]; then
    [[ -n "${options[mxid]}" ]] || {
      local input_new_room_mxid
      Read -r -p "New room user MXID:" input_new_room_mxid
      options[mxid]="$input_new_room_mxid"
    }
    body_params[new_room_user_id]="${options[mxid]}"

    [[ -z "${options[room_name]}" ]] && {
      local input_room_name
      Read -r -p "New room name:" input_room_name
      options[room_name]="$input_room_name"
    }
    body_params[room_name]="${options[room_name]}"

    [[ -z "${options[message]}" ]] && {
      local input_message
      Read -r -p "New room message:" input_message
      options[message]="$input_message"
    }
    body_params[message]="${options[message]}"
  fi

  SetPathParameters url_params api[path]

  # construct request body
  local object
  ConstructObject s_delete_room body_params object || return 1

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
    [data]="$object"
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }

  # get key values
  local -a keys=(delete_id)
  local -A values
  ProcessResponse response[body] keys values || return 1

  # output
  echo -e "Deletion Job ID: ${values[delete_id]}\n"
}

MatrixDeleteAlias() {
  Log debug "Got args '$*'"

  # copy api map to local map
  local -A api
  CopyArray m_delete_alias_api api
  # copy path parameters to local map
  local -A path_params
  CopyArray m_delete_alias_path_params path_params

  CheckLoginStatus || return 1

  local -n __MatrixDeleteAlias_args="$1"
  local -A options
  ParseOptions __MatrixDeleteAlias_args options
  # ask for alias if not passed
  [[ -n "${options[alias]}" ]] || {
    local input_alias
    Read -r -p "$(printf '%s' 'Alias to delete:')" input_alias
    options[alias]="$input_alias"
  }
  PutArray path_params[alias] "${options[alias]}"

  SetPathParameters path_params api[path]

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
    [auth]='true'
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }
}

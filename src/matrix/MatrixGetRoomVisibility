MatrixGetRoomVisibility() {
  Log debug "Got args '$*'"

  local -n __MatrixGetRoomVisibility_args="$1"
  if [[ "${__MatrixGetRoomVisibility_args[0]}" == 'set' ]]; then
    ShiftArray __MatrixGetRoomVisibility_args || return 1
    MatrixSetRoomVisibility __MatrixGetRoomVisibility_args || return 1
    return 0
  fi

  # copy api map to local map
  local -A api
  CopyArray m_room_visibility_api api
  # copy url parameters to local map
  local -A url_params
  CopyArray m_room_visibility_url_params url_params

  CheckLoginStatus || return 1

  local -A options
  ParseOptions __MatrixGetRoomVisibility_args options
  # ask for value if not passed
  [[ -n "${options[room_id]}" ]] || {
    local input_room_id
    Read -r -p "$(echo -e -n '\nRoom ID: ')" input_room_id
    options[room_id]="$input_room_id"
  }
  url_params[room_id]="${options[room_id]}"

  SetPathParameters url_params api[path]

  # set request parameters
  local -A params=(
    [method]="${api[method]}"
    [path]="${api[path]}"
  )
  # make request
  local -A response
  Request params response || return 1
  CheckStatusCode "${response[status]}" || {
    HandleMatrixError response[body]
    return 1
  }

  local -a keys=(visibility)
  local -A values
  ProcessResponse response[body] keys values

  echo "Visibility: ${values[visibility]}"
}

MatrixDiscover() {
  Log debug "Got args '$*'."

  local -n __MatrixDiscover_args="$1"
  local -A options
  ParseOptions __MatrixDiscover_args options
  [[ -n "${options[server_name]}" ]] || {
    local input_server_name
    Read -r -p "Server name: " input_server_name
    options[server_name]="$input_server_name"
  }

  ValidateInput host "${options[server_name]}" || return 1

  local base_url
  GetWellKnown "${options[server_name]}" base_url || {
    Log error "Matrix server discovery failed for server '${options[server_name]}'"
    return 1
  }

  echo "Base URL: $base_url"
}

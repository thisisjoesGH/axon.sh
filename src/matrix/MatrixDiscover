MatrixDiscover() {
  local server_name="$1"

  [[ ! -z "$server_name" ]] || {
    local input_server_name
    Read -r -p "Server name: " input_server_name
      server_name="$input_server_name"
  }

  ValidateInput host "$server_name" || return 1

  local base_url
  GetWellKnown "$server_name" base_url || {
    Log error "Matrix server discovery failed for server '$server_name'"
    return 1
  }

  echo "Base URL: $base_url"
}

Main() {
  DefineConfiguration
  ReadEnvironment
  ReadConfiguration
  ReadEnvironment
  CreateFiles
  Log config "Log level set to '${config[log_level]}'"
  Log config "Verbosity set to '${config[verbosity]}'"
  GenerateDeviceID
  WriteConfiguration
  DefineStatusCodes
  DefineObjects
  DefineMatrixParams
  DefineMatrixEndpoints
  DefineSynapseParams
  DefineSynapseEndpoints
  DefineOutputStrings
  CheckDependencies
  if (( "$#" < 1 )); then
    PrintInfo short
    Prompt
  else
    local -a input=("$@")
    HandleCommand input
  fi
}

trap CancelPrompt SIGINT SIGQUIT SIGTERM

Main "$@"
